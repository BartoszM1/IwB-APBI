  <folder name="Motivation" id="id-45fd06f6d0b64567a247d8f9d56afdc3" type="motivation">
    <documentation>Zwiększyć wydajność o 15% i skrócić przestoje o 20% poprzez integrację MES z ERP oraz pełny tracing partii (kakao → masa → formowanie → pakowanie). </documentation>
    <element xsi:type="archimate:Stakeholder" id="id-4570c89ffbdb4211b065f5c19a74a167"/>
    <element xsi:type="archimate:Driver" name="Wysokie przestoje linii" id="id-c9519a73858b41b59a2dfc030a3a2aed"/>
    <element xsi:type="archimate:Driver" name="Brak pełnej identyfikowalności partii" id="id-d5e5275714594f4db2ec12339f7d3141"/>
    <element xsi:type="archimate:Goal" name="Zwiększenie wydajności produkcji o 15%" id="id-ff96b02ac3e64337ae6e4f02e7525365"/>
    <element xsi:type="archimate:Goal" name="Redukcja przestojów o 20%" id="id-aa04a311aca0452dad0da4e60d6bae52"/>
    <element xsi:type="archimate:Outcome" name="Pełna widoczność procesu produkcyjnego" id="id-9d31b8c55d954dedb7619a7ef7443d58"/>
    <element xsi:type="archimate:Outcome" name="Szybsza reakcja na odchylenia" id="id-70de1a64ef9b4bd697e341ab4634199e"/>
    <element xsi:type="archimate:Requirement" name="Integracja MES–ERP" id="id-8e81253b87164200aac61be2784ae94f"/>
    <element xsi:type="archimate:Requirement" name="Pełny tracing partii w czasie rzeczywistym" id="id-1def03a8ab0c4a85b7c3f731bc215a3f"/>
  </folder>
