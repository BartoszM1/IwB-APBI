  <folder name="Strategy" id="id-cd8b334f34b245ada678b764eeeb09a5" type="strategy"/>
  <folder name="Business" id="id-a74aa337c9124cd6bf1da2374b6e6dc3" type="business">
    <documentation>Aktorzy (Planista, Mistrz Zmiany, QA, Maintenance), role, procesy „Order-to-Batch”, „Traceability”, „CAPA”. </documentation>
    <element xsi:type="archimate:BusinessActor" name="Planista" id="id-3640f8bbc9504b0d8cf25f1baf14fc95"/>
    <element xsi:type="archimate:BusinessActor" name="Mistrz Zmiany" id="id-24000a9207474ca39d6cd543ce1f5fe3"/>
    <element xsi:type="archimate:BusinessActor" name="QA" id="id-c95a96891617411797d3f5b7556f0138"/>
    <element xsi:type="archimate:BusinessActor" name="Utrzymanie Ruchu" id="id-c0e9d9bce0a8477ca25df9b8b43681d0"/>
    <element xsi:type="archimate:BusinessRole" name="Planner" id="id-032191170b4d4cb2bec507ca6d07ea53">
      <documentation>Order-to-Batch&#xD;
&#xD;
Proces end-to-end obejmujący:&#xD;
&#xD;
przyjęcie zapotrzebowania / zamówienia,&#xD;
&#xD;
planowanie zlecenia produkcyjnego,&#xD;
&#xD;
uruchomienie i realizację produkcji,&#xD;
&#xD;
raportowanie wykonania partii.&#xD;
&#xD;
Relacje:&#xD;
&#xD;
Planner performs Order-to-Batch&#xD;
&#xD;
Production Supervisor performs Order-to-Batch</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Production Supervisor" id="id-03448b506386465e99df3aa12a80e854"/>
    <element xsi:type="archimate:BusinessRole" name="Quality Controller" id="id-0d23bbdea13c4294bb3d2e63d9cbe19f"/>
    <element xsi:type="archimate:BusinessRole" name="Maintenance Technician" id="id-aeaa4dae72d845d6b1a864a6ef63f1d4"/>
    <element xsi:type="archimate:BusinessService" name="Order-to-Batch" id="id-76f548c561ee413681982cb4e17202c7"/>
    <element xsi:type="archimate:BusinessService" name="Traceability" id="id-0219a05ed5ef471686a0242b754c158c"/>
    <element xsi:type="archimate:BusinessService" name="CAPA" id="id-74d3ce0a183c4d6fa407508a7e7d2163"/>
  </folder>
  <folder name="Application" id="id-6d6e2dea902f423f8aff325bd188aa3a" type="application">
    <documentation>ERP – Planowanie i Zakupy&#xD;
&#xD;
MES – Wykonanie produkcji&#xD;
&#xD;
LIMS / QA – Zarządzanie jakością i badaniami laboratoryjnymi&#xD;
&#xD;
WMS – Zarządzanie magazynem&#xD;
&#xD;
SCADA / HMI – Nadzór i sterowanie procesem</documentation>
    <element xsi:type="archimate:ApplicationComponent" name="ERP" id="id-c71be7d5fc754adbb06c1137accd7728">
      <documentation>Planowanie i zzakupy</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="MES" id="id-d5da0f7b13564ff5841e95f47e489963">
      <documentation>Wykonanie produkcji</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="LIMS / QA" id="id-031c041ace4d484f85d53db41c03a096">
      <documentation>Zarządzanie jakością i badaniami laboratoryjnymi</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="WMS" id="id-48936056225e445284d9b2270a63f2c3">
      <documentation>Zarządzanie magazynem</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="SCADA / HMI" id="id-e41eb14e09ac467abb3be4c5c481da89">
      <documentation>Nadzór i sterowanie procesem</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-9d513fb40d2e47d2be6064be088f7638" type="technology">
    <documentation>•	Warstwa technologii: Węzły (Serwer MES, Serwer ERP, Edge Gateway), urządzenia &#xD;
(PLC, czujniki temperatury, wagi), oprogramowanie systemowe (Linux/Windows Server, OPC-UA server), usługi technologiczne („Monitoring linii”, „Integracja OPCUA”, „ETL do ERP”). &#xD;
</documentation>
